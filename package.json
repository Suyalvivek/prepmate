{
  "name": "prepmate",
  "version": "1.0.0",
  "private": true,
  "description": "PrepMate — AI-powered competitive exam preparation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --cwd apps/frontend dev",
    "dev:backend": "bun run --cwd apps/backend dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "bun run --filter '*' lint",
    "format": "bunx prettier --write \"**/*.{ts,tsx,json,md,css}\" --ignore-path .gitignore",
    "db:generate": "bun run --cwd apps/backend db:generate",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "db:migrate:dev": "bun run --cwd apps/backend db:migrate:dev",
    "db:seed": "bun run --cwd apps/backend db:seed",
    "db:studio": "bun run --cwd apps/backend db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "bun install && bun docker:up && sleep 3 && bun db:migrate && echo '\\n✅ PrepMate dev environment ready'"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
