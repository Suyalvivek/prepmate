# Root environment example — copy to .env and fill values
# Never commit real values

# ── Shared ────────────────────────────────────────
NODE_ENV=development

# ── Frontend (VITE_ prefix = public, safe to expose) ──
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ── Backend ───────────────────────────────────────
PORT=4000
DATABASE_URL=postgresql://prepmate:prepmate_dev@localhost:5432/prepmate_dev
TEST_DATABASE_URL=postgresql://prepmate:prepmate_test@localhost:5433/prepmate_test

# Firebase Admin (one of: path OR individual fields)
# Option A — path to downloaded service account JSON (local dev only)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
# Option B — individual fields (better for CI/prod)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=   # paste the full PEM value (with \n escapes)

# AI Provider (platform key; users supply their own via BYOK)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-pro

# BYOK encryption — 32-byte hex secret for AES-256-GCM
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# API hardening
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
